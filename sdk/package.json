{
  "name": "@iln/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Invoice Liquidity Network smart contracts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.config.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage node_modules/.cache",
    "docs": "typedoc --out docs src/index.ts",
    "size": "pnpm run build && size-limit"
  },
  "size-limit": [
    {
      "name": "ESM bundle",
      "path": "dist/index.mjs",
      "limit": "50 KB",
      "import": "@size-limit/file"
    },
    {
      "name": "CJS bundle",
      "path": "dist/index.js",
      "limit": "60 KB",
      "import": "@size-limit/file"
    }
  ],
  "dependencies": {
    "@invoice-liquidity/types": "workspace:*",
    "@stellar/stellar-sdk": "^12.3.0"
  },
  "devDependencies": {
    "@iln/test-utils": "workspace:*",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^3.15.0",
    "@size-limit/file": "^11.1.6",
    "git-cliff": "^2.2.1",
    "size-limit": "^11.1.6",
    "tsup": "^8.0.2",
    "typedoc": "^0.25.12",
    "typescript": "^5.4.0",
    "vitest": "^1.6.1"
  }
}
